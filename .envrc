# >>> octo envrc >>>
# Managed by 'octo callback install envrc' — config lives in .octo/envrc.yml
# (plus any .octo/envrc/*.yml fragments beside it).
command -v octo >/dev/null 2>&1 && eval "$(octo callback invoke envrc emit)" \
  || echo "direnv: octo not installed — repo env not loaded" >&2
# <<< octo envrc <<<
